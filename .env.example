# Client environment variables (Vite)
# Only public anon keys belong here — NEVER put the service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>
VITE_SUPABASE_GOOGLE_ENABLED=true
# Optional: the URL encoded in Device handoff QR codes and magic links.
# Falls back to window.location.origin when omitted.
VITE_PUBLIC_APP_URL=https://daylabels.app

